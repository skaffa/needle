{
	"schemaVersion": 1,
	"id": "needle",
	"version": "${version}",
	"name": "Needle",
	"description": "Client-side Last.fm scrobbler for Minecraft's own music and jukebox songs. Counts only the time you actually hear a track.",
	"authors": [
		"Skaffa",
		"Claude (Anthropic)"
	],
	"contact": {
		"homepage": "https://github.com/skaffa/needle",
		"sources": "https://github.com/skaffa/needle",
		"issues": "https://github.com/skaffa/needle/issues"
	},
	"license": "MIT",
	"icon": "assets/needle/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.needle.client.NeedleClient"
		],
		"modmenu": [
			"dev.needle.client.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "needle.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
